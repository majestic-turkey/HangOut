{
    "name": "hangout",
    "version": "0.5.0",
    "description": "Multiplayer Hangman",
    "keywords": [
        "hangman",
        "multiplayer",
        "game"
    ],
    "homepage": "https://github.com/majestic-turkey/HangOut#readme",
    "bugs": {
        "url": "https://github.com/majestic-turkey/HangOut/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/majestic-turkey/HangOut.git"
    },
    "license": "ISC",
    "author": "Saltworks",
    "type": "module",
    "main": "server.ts",
    "scripts": {
        "dev": "npm run dev:all",
        "start": "npm run dev:server",
        "build": "npm run typecheck && npm --prefix frontend run build",
        "typecheck": "tsc -p tsconfig.json",
        "dev:server": "npx nodemon server.ts",
        "dev:client": "npm --prefix frontend run dev",
        "dev:all": "npx concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\""
    },
    "dependencies": {
        "dotenv": "^17.4.1",
        "express": "^4.22.1",
        "nanoid": "^5.1.7",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "socket.io": "^4.8.3",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.11",
        "ts-node": "^9.1.1",
        "typescript": "^6.0.2"
    }
}
